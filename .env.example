# Server Configuration
PORT=3000

# Gemini API Key (Generate one from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Flow Webhook URL (The webhook endpoint that posts to LinkedIn)
WEBHOOK_URL=your_google_flow_webhook_url_here

# Cron Secret token (Used to secure the daily trigger API endpoint from unauthorized requests in production)
CRON_SECRET=a_secure_random_string_here
